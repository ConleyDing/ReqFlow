# Copy to deploy/.env and replace all placeholders before first deployment.
# Do not commit deploy/.env.

APP_BIND_ADDRESS=127.0.0.1

# Development default. Pin to a tested immutable image digest for a tagged release.
POSTGRES_IMAGE=postgres:17-alpine
APP_PORT=8080

POSTGRES_DB=reqflow
POSTGRES_USER=reqflow_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# OpenAI-compatible or provider-specific endpoint; keep blank until configured.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_RETRIES=1
LOG_LEVEL=INFO
